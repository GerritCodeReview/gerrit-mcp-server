      "writtenOn": "2026-10-07T10:37:01Z",
      "side": 1,
      "message": "No. Intraline data only adds the offsets of the changed characters inside a modified line. Each entry already carries the whole old and new line, so a model sees the change without them.",
      "parentUuid": "bc89481b_7eb8d406",
      "revId": "f0b1a7a15b963de8b630cec57b9330dd837fea5f",
      "serverId": "173816e5-2b9a-37c3-8a2e-48639d4f1153"
