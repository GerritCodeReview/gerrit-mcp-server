      },
      "writtenOn": "2026-10-07T10:37:01Z",
      "side": 1,
      "message": "The chunk loop is an if/elif chain over ab, skip, and a/b, so the code states that a chunk carries one of them.",
      "parentUuid": "4a781ad7_54add3d9",
      "revId": "f0b1a7a15b963de8b630cec57b9330dd837fea5f",
      "serverId": "173816e5-2b9a-37c3-8a2e-48639d4f1153"
